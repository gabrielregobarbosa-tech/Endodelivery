# Node.js 24 LTS. Nunca versione credenciais ou dados de pacientes.
# Desenvolvimento local sem URLs: SQLite e arquivos privados persistentes.
DATABASE_PATH=./data/endodelivery.sqlite
FILE_STORAGE_PATH=./data/uploads
# PostgreSQL gerenciado: configure DATABASE_URL ou POSTGRES_URL no painel seguro.
# DATABASE_PROVIDER=postgres
# Vercel: conecte um Blob Store PRIVATE ao projeto para injetar o token.
# STORAGE_PROVIDER=vercel-blob
# BLOB_READ_WRITE_TOKEN deve ser definido somente no painel seguro, sem valor neste arquivo.
# Na Vercel, não use DATABASE_PATH, FILE_STORAGE_PATH nem /tmp para dados clínicos.
# Consulte docs/vercel.md. Localmente, a origem é detectada da requisição.
# APP_ORIGIN=https://seu-dominio.example
