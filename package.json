{
  "name": "endodelivery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "build:vercel": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:postgres": "node --import tsx --test tests/database-postgres.integration.ts",
    "test:serverless": "node --import tsx --test tests/serverless.integration.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:check": "node --import tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/blob": "^2.8.2",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
